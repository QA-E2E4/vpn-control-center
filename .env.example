# Copy values to a protected service EnvironmentFile outside the web root.
# Never commit real hostnames, keys, cookies, tokens, or connection profiles.

# Core binaries
OPENFLUX_CORE_BINARY=/usr/local/bin/openflux
OPENFLUX_MAILRU_BINARY=/usr/local/bin/openflux

# Panel data; directories must be owned by the service account and mode 0700.
OPENFLUX_PANEL_DATA_DIR=/var/lib/openflux-panel
OPENFLUX_PANEL_CHANNELS_DIR=/var/lib/openflux-panel-channels
OPENFLUX_IPC_DIR=/run/openflux-panel-ipc
OPENFLUX_SYSTEMD_UNIT_DIR=/etc/systemd/system
OPENFLUX_MAIN_KEY=/var/lib/openflux/secret.txt

# Optional existing VPN integrations. Configure only when those services
# already exist and have been reviewed for this server.
OPENFLUX_XRAY_BINARY=/usr/local/bin/xray
OPENFLUX_XRAY_CONTAINER=xray-reality
OPENFLUX_XRAY_API=127.0.0.1:10085
OPENFLUX_AMNEZIA_CONTAINER=amnezia-awg
OPENFLUX_AMNEZIA_INTERFACE=awg0
